---
import Base from '../../layouts/Base.astro';
import SchemaNegocio from '../../components/SchemaNegocio.astro';
import zonas from '../../data/zonas.json';
import negocio from '../../data/negocio.json';

// Poblaciones con página propia (núcleo + las priorizadas) vs. resto del área de servicio.
const conPagina = new Set(['Granollers', ...zonas.map((z) => z.nombre)]);
const soloArea = negocio.nap.zona_servicio.filter((t) => !conPagina.has(t));

const breadcrumb = [
  { name: 'Inicio', path: '/' },
  { name: 'Zonas', path: '/zonas/' },
];
const title = `Zonas de servicio · Cerrajero 24h en el Vallès Oriental | ${negocio.marca}`;
const description = 'Cerrajero 24 horas en Granollers y alrededores: Canovelles, Les Franqueses, La Roca del Vallès, Montmeló y Vilanova del Vallès. Precio cerrado antes de salir.';
---
<Base title={title} description={description} canonicalPath="/zonas/">
  <SchemaNegocio slot="head" breadcrumb={breadcrumb} />

  <section class="bg-brand-900 text-white">
    <div class="max-w-5xl mx-auto px-4 py-12 text-center">
      <p class="text-accent-500 font-semibold uppercase tracking-wide text-sm">Vallès Oriental</p>
      <h1 class="mt-3 text-3xl sm:text-4xl font-bold">Zonas donde damos servicio</h1>
      <p class="mt-4 text-lg text-slate-200 max-w-2xl mx-auto">Cobertura 24 horas en Granollers y su entorno más cercano. Precio cerrado por teléfono antes de desplazarnos.</p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 py-12">
    <div class="grid gap-5 sm:grid-cols-2 md:grid-cols-3">
      <a href="/" class="block rounded-xl border-2 border-brand-500 p-5 hover:shadow-sm transition">
        <h2 class="font-bold text-brand-900">Granollers</h2>
        <p class="mt-2 text-sm text-slate-600">Núcleo de servicio. Cerrajero 24 horas en toda la ciudad.</p>
        <span class="mt-3 inline-block text-brand-700 font-semibold text-sm">Ir a la home →</span>
      </a>
      {zonas.map((z) => (
        <a href={`/zonas/${z.slug}/`} class="block rounded-xl border border-slate-200 p-5 hover:border-brand-500 hover:shadow-sm transition">
          <h2 class="font-bold text-brand-900">{z.nombre}</h2>
          <p class="mt-2 text-sm text-slate-600">{z.intro.slice(0, 90)}…</p>
          <span class="mt-3 inline-block text-brand-700 font-semibold text-sm">Ver zona →</span>
        </a>
      ))}
    </div>
  </section>

  {soloArea.length > 0 && (
    <section class="max-w-5xl mx-auto px-4 pb-14">
      <div class="rounded-xl bg-slate-50 border border-slate-200 p-6">
        <h2 class="text-lg font-bold text-brand-900">También damos servicio en el resto del Vallès Oriental</h2>
        <p class="mt-2 text-sm text-slate-600">
          Cerrajero 24 horas con precio cerrado también en: {soloArea.join(' · ')}.
        </p>
        <p class="mt-3 text-sm">
          Llama al <a href={`tel:${negocio.telefono_e164}`} class="text-brand-700 font-semibold">{negocio.telefono_display}</a> y te confirmamos disponibilidad y precio antes de salir.
        </p>
      </div>
    </section>
  )}
</Base>
