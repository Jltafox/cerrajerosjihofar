---
import negocio from '../data/negocio.json';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
}
const { title, description, canonicalPath = '/' } = Astro.props;
const canonical = new URL(canonicalPath, Astro.site ?? 'https://ejemplo-pendiente.example').href;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index,follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <slot name="head" />
  </head>
  <body class="bg-white text-slate-800">
    {negocio.provisional && (
      <div class="bg-amber-400 text-amber-950 text-center text-sm font-medium px-4 py-2">
        ⚠️ Sitio de EJEMPLO · marca, teléfono, dirección, precios y reseñas son provisionales — pendientes de datos reales.
      </div>
    )}

    <header class="border-b border-slate-200">
      <div class="max-w-5xl mx-auto flex items-center justify-between px-4 py-3">
        <a href="/" class="font-bold text-lg text-brand-900">{negocio.marca}</a>
        <nav class="hidden sm:flex gap-5 text-sm font-medium">
          <a href="/" class="hover:text-brand-500">Inicio</a>
          <a href="/servicios/" class="hover:text-brand-500">Servicios</a>
          <a href="/zonas/" class="hover:text-brand-500">Zonas</a>
          <a href="/precios/" class="hover:text-brand-500">Precios</a>
          <a href="/contacto/" class="hover:text-brand-500">Contacto</a>
          <a href={`tel:${negocio.telefono_e164}`} class="text-brand-700 font-semibold">{negocio.telefono_display}</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-16 border-t border-slate-200 bg-slate-50">
      <div class="max-w-5xl mx-auto px-4 py-8 text-sm text-slate-600">
        <p class="font-semibold text-slate-800">{negocio.nap.nombre}</p>
        <p>{negocio.nap.calle} · {negocio.nap.cp} {negocio.nap.localidad} ({negocio.nap.region})</p>
        <p>Tel: <a href={`tel:${negocio.telefono_e164}`} class="text-brand-700">{negocio.telefono_display}</a> · {negocio.nap.horario_texto}</p>
        <p class="mt-3 text-xs text-slate-400">Zona de servicio: {negocio.nap.zona_servicio.join(' · ')}</p>
        <nav class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs">
          <a href="/servicios/" class="text-slate-500 hover:text-brand-500">Servicios</a>
          <a href="/zonas/" class="text-slate-500 hover:text-brand-500">Zonas</a>
          <a href="/precios/" class="text-slate-500 hover:text-brand-500">Precios</a>
          <a href="/comunidades-y-administradores/" class="text-slate-500 hover:text-brand-500">Comunidades</a>
          <a href="/lanzamientos-judiciales/" class="text-slate-500 hover:text-brand-500">Lanzamientos judiciales</a>
          <a href="/blog/" class="text-slate-500 hover:text-brand-500">Blog</a>
          <a href="/sobre-nosotros/" class="text-slate-500 hover:text-brand-500">Sobre nosotros</a>
          <a href="/contacto/" class="text-slate-500 hover:text-brand-500">Contacto</a>
        </nav>
      </div>
    </footer>

    <!-- CTA telefónico sticky (H4: 100% de los ganadores lo tienen) -->
    <a
      href={`tel:${negocio.telefono_e164}`}
      class="sm:hidden fixed bottom-0 inset-x-0 z-50 bg-brand-700 text-white text-center font-semibold py-3 shadow-lg"
    >
      📞 Llamar ahora · {negocio.telefono_display}
    </a>
  </body>
</html>
