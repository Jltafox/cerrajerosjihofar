---
import Base from '../../layouts/Base.astro';
import SchemaNegocio from '../../components/SchemaNegocio.astro';
import blog from '../../data/blog.json';
import negocio from '../../data/negocio.json';

const posts = [...blog].sort((a, b) => (a.fecha < b.fecha ? 1 : -1));
const breadcrumb = [
  { name: 'Inicio', path: '/' },
  { name: 'Blog', path: '/blog/' },
];
const title = `Blog de cerrajería · precios y consejos | ${negocio.marca}`;
const description = 'Consejos de cerrajería y precios orientativos: cuánto cuesta una apertura, cambiar una cerradura o un bombín antibumping. Sin sorpresas.';
---
<Base title={title} description={description} canonicalPath="/blog/">
  <SchemaNegocio slot="head" breadcrumb={breadcrumb} />

  <section class="bg-brand-900 text-white">
    <div class="max-w-5xl mx-auto px-4 py-12 text-center">
      <h1 class="text-3xl sm:text-4xl font-bold">Blog de cerrajería</h1>
      <p class="mt-4 text-lg text-slate-200 max-w-2xl mx-auto">Precios orientativos y consejos claros. Lo que deberías saber antes de llamar a un cerrajero.</p>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 py-12">
    <div class="space-y-6">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}/`} class="block rounded-xl border border-slate-200 p-6 hover:border-brand-500 hover:shadow-sm transition">
          <p class="text-xs text-slate-400">{post.fecha}</p>
          <h2 class="mt-1 text-xl font-bold text-brand-900">{post.titulo}</h2>
          <p class="mt-2 text-slate-600">{post.resumen}</p>
          <span class="mt-3 inline-block text-brand-700 font-semibold text-sm">Leer artículo →</span>
        </a>
      ))}
    </div>
  </section>
</Base>
