---
import Base from '../../layouts/Base.astro';
import SchemaNegocio from '../../components/SchemaNegocio.astro';
import servicios from '../../data/servicios.json';
import negocio from '../../data/negocio.json';

const breadcrumb = [
  { name: 'Inicio', path: '/' },
  { name: 'Servicios', path: '/servicios/' },
];
const title = `Servicios de cerrajería en ${negocio.nap.localidad} | ${negocio.marca}`;
const description = `Todos nuestros servicios de cerrajería 24h en ${negocio.nap.localidad}: aperturas, cambio de cerraduras y bombines, alta seguridad y más. Precio cerrado antes de salir.`;
---
<Base title={title} description={description} canonicalPath="/servicios/">
  <SchemaNegocio slot="head" breadcrumb={breadcrumb} />

  <section class="bg-brand-900 text-white">
    <div class="max-w-5xl mx-auto px-4 py-12 text-center">
      <p class="text-accent-500 font-semibold uppercase tracking-wide text-sm">Cerrajero 24h · {negocio.nap.localidad}</p>
      <h1 class="mt-3 text-3xl sm:text-4xl font-bold">Servicios de cerrajería en {negocio.nap.localidad}</h1>
      <p class="mt-4 text-lg text-slate-200 max-w-2xl mx-auto">Del cierre de emergencia a la alta seguridad. En todos, el precio cerrado por teléfono antes de desplazarnos.</p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 py-12">
    <div class="grid gap-5 sm:grid-cols-2 md:grid-cols-3">
      {servicios.map((s) => (
        <a href={`/servicios/${s.slug}/`} class="block rounded-xl border border-slate-200 p-5 hover:border-brand-500 hover:shadow-sm transition">
          <h2 class="font-bold text-brand-900">{s.nav}</h2>
          <p class="mt-2 text-sm text-slate-600">{s.meta}</p>
          <span class="mt-3 inline-block text-brand-700 font-semibold text-sm">Ver servicio →</span>
        </a>
      ))}
    </div>
    <div class="mt-8 rounded-2xl border border-brand-500 bg-brand-900 text-white p-6 sm:flex items-center justify-between gap-6">
      <div>
        <p class="text-accent-500 font-semibold uppercase tracking-wide text-sm">Servicio profesional · B2B</p>
        <h2 class="mt-1 text-xl font-bold">Lanzamientos judiciales</h2>
        <p class="mt-1 text-slate-200 text-sm max-w-xl">Apoyo de cerrajería a procuradores y administradores de fincas en el Vallès Oriental y Barcelona.</p>
      </div>
      <a href="/lanzamientos-judiciales/" class="inline-block mt-3 sm:mt-0 shrink-0 rounded-lg bg-accent-500 text-brand-900 font-bold px-5 py-2.5 hover:brightness-95">Ver servicio →</a>
    </div>

    <div class="mt-8 text-center">
      <a href="/precios/" class="inline-block rounded-lg bg-brand-700 text-white font-semibold px-6 py-3 hover:bg-brand-900">Ver todos los precios</a>
    </div>
  </section>
</Base>
