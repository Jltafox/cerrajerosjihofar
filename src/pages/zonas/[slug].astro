---
import Base from '../../layouts/Base.astro';
import SchemaNegocio from '../../components/SchemaNegocio.astro';
import MapaNAP from '../../components/MapaNAP.astro';
import zonas from '../../data/zonas.json';
import servicios from '../../data/servicios.json';
import negocio from '../../data/negocio.json';

export function getStaticPaths() {
  return zonas.map((z) => ({ params: { slug: z.slug }, props: { zona: z } }));
}

const { zona } = Astro.props;
const otras = zonas.filter((z) => z.slug !== zona.slug);

const breadcrumb = [
  { name: 'Inicio', path: '/' },
  { name: 'Zonas', path: '/zonas/' },
  { name: zona.nombre, path: `/zonas/${zona.slug}/` },
];

const title = `Cerrajero 24 horas en ${zona.nombre} | ${negocio.marca}`;
const description = `Cerrajero urgente 24h en ${zona.nombre} (Vallès Oriental). Aperturas sin romper, cambio de cerraduras y bombines. Precio cerrado antes de salir.`;
---
<Base title={title} description={description} canonicalPath={`/zonas/${zona.slug}/`}>
  <SchemaNegocio slot="head" serviceType={`Cerrajero 24 horas en ${zona.nombre}`} faq={zona.faq} breadcrumb={breadcrumb} />

  <nav aria-label="Migas de pan" class="max-w-5xl mx-auto px-4 pt-5 text-xs text-slate-500">
    <a href="/" class="hover:text-brand-500">Inicio</a> ›
    <a href="/zonas/" class="hover:text-brand-500">Zonas</a> ›
    <span class="text-slate-700">{zona.nombre}</span>
  </nav>

  <section class="bg-brand-900 text-white mt-4">
    <div class="max-w-5xl mx-auto px-4 py-12 text-center">
      <p class="text-accent-500 font-semibold uppercase tracking-wide text-sm">Vallès Oriental</p>
      <h1 class="mt-3 text-3xl sm:text-4xl font-bold">Cerrajero 24 horas en {zona.nombre}</h1>
      <p class="mt-4 text-lg text-slate-200 max-w-2xl mx-auto">{zona.intro}</p>
      <a href={`tel:${negocio.telefono_e164}`} class="inline-block mt-6 rounded-lg bg-accent-500 text-brand-900 font-bold px-6 py-3 hover:brightness-95">
        📞 Pedir precio cerrado · {negocio.telefono_display}
      </a>
    </div>
  </section>

  <!-- Servicios en esta zona (internal linking a /servicios/) -->
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-brand-900 mb-6">Servicios de cerrajería en {zona.nombre}</h2>
    <div class="grid gap-3 sm:grid-cols-2 md:grid-cols-4">
      {servicios.map((s) => (
        <a href={`/servicios/${s.slug}/`} class="rounded-lg border border-slate-200 px-4 py-3 hover:border-brand-500 hover:text-brand-700 font-medium text-slate-700 text-center">
          {s.nav}
        </a>
      ))}
    </div>
    <a href="/precios/" class="inline-block mt-6 text-brand-700 font-semibold underline">Ver precios orientativos →</a>
  </section>

  <!-- FAQ (visible + FAQPage schema) -->
  <section class="max-w-3xl mx-auto px-4 pb-12">
    <h2 class="text-2xl font-bold text-brand-900 mb-6">Preguntas frecuentes sobre {zona.nombre}</h2>
    <div class="space-y-3">
      {zona.faq.map((f) => (
        <details class="rounded-lg border border-slate-200 px-4 py-3">
          <summary class="font-semibold text-slate-800 cursor-pointer">{f.q}</summary>
          <p class="mt-2 text-sm text-slate-600">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <MapaNAP lat={zona.lat} lng={zona.lng} localidad={zona.nombre} />

  <!-- Zonas próximas (internal linking) -->
  <section class="bg-slate-50 border-t border-slate-200">
    <div class="max-w-5xl mx-auto px-4 py-12">
      <h2 class="text-xl font-bold text-brand-900 mb-6">Zonas próximas que también cubrimos</h2>
      <div class="grid gap-3 sm:grid-cols-2 md:grid-cols-3">
        <a href="/" class="rounded-lg bg-white border border-slate-200 px-4 py-3 hover:border-brand-500 hover:text-brand-700 font-medium text-slate-700">Granollers</a>
        {otras.map((z) => (
          <a href={`/zonas/${z.slug}/`} class="rounded-lg bg-white border border-slate-200 px-4 py-3 hover:border-brand-500 hover:text-brand-700 font-medium text-slate-700">
            {z.nombre}
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
