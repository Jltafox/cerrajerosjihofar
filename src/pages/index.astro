---
import Base from '../layouts/Base.astro';
import SchemaNegocio from '../components/SchemaNegocio.astro';
import Resenas from '../components/Resenas.astro';
import MapaNAP from '../components/MapaNAP.astro';
import negocio from '../data/negocio.json';
import servicios from '../data/servicios.json';
import zonas from '../data/zonas.json';

const title = `${negocio.marca} · Cerrajero 24h en ${negocio.nap.localidad}`;
const description = 'Cerrajero urgente 24 horas en Granollers y el Vallès Oriental. Precio cerrado por teléfono antes de salir. Sin sorpresas al llegar.';
---
<Base title={title} description={description} canonicalPath="/">
  <SchemaNegocio slot="head" />

  <section class="bg-brand-900 text-white">
    <div class="max-w-5xl mx-auto px-4 py-16 text-center">
      <p class="text-accent-500 font-semibold uppercase tracking-wide text-sm">Precio cerrado · sin sorpresas</p>
      <h1 class="mt-3 text-3xl sm:text-5xl font-bold">Cerrajero 24 horas {negocio.nap.localidad}</h1>
      <p class="mt-4 text-xl font-semibold text-white">{negocio.posicionamiento.claim}</p>
      <p class="mt-2 text-lg text-slate-200 max-w-2xl mx-auto">{negocio.posicionamiento.subclaim}</p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a href={`tel:${negocio.telefono_e164}`} class="rounded-lg bg-accent-500 text-brand-900 font-bold px-6 py-3 hover:brightness-95">
          📞 Llamar ahora · {negocio.telefono_display}
        </a>
        <a href="/precios/" class="rounded-lg border border-white/40 text-white font-semibold px-6 py-3 hover:bg-white/10">
          Ver precios
        </a>
      </div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 py-12 grid gap-6 sm:grid-cols-3 text-center">
    <div class="rounded-xl border border-slate-200 p-6">
      <p class="text-3xl">🕐</p>
      <h2 class="mt-2 font-bold text-brand-900">24 horas, todo el año</h2>
      <p class="mt-1 text-sm text-slate-600">Urgencias de día, de noche y en festivo en {negocio.nap.localidad} y comarca.</p>
    </div>
    <div class="rounded-xl border border-slate-200 p-6">
      <p class="text-3xl">💶</p>
      <h2 class="mt-2 font-bold text-brand-900">Precio cerrado</h2>
      <p class="mt-1 text-sm text-slate-600">Te lo confirmamos por teléfono antes de salir. <a href="/precios/" class="text-brand-700 underline">Ver precios</a>.</p>
    </div>
    <div class="rounded-xl border border-slate-200 p-6">
      <p class="text-3xl">🔓</p>
      <h2 class="mt-2 font-bold text-brand-900">Abrir sin romper</h2>
      <p class="mt-1 text-sm text-slate-600">Técnicas no destructivas como prioridad. Solo se rompe si no hay alternativa.</p>
    </div>
  </section>

  <!-- Servicios (internal linking home → servicios) -->
  <section class="bg-slate-50 border-y border-slate-200">
    <div class="max-w-5xl mx-auto px-4 py-12">
      <div class="text-center mb-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-brand-900">Nuestros servicios en {negocio.nap.localidad}</h2>
        <p class="mt-2 text-slate-600">Del cierre de emergencia a la alta seguridad. Precio cerrado en todos.</p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2 md:grid-cols-4">
        {servicios.map((s) => (
          <a href={`/servicios/${s.slug}/`} class="rounded-lg bg-white border border-slate-200 px-4 py-3 hover:border-brand-500 hover:text-brand-700 font-medium text-slate-700 text-center">
            {s.nav}
          </a>
        ))}
      </div>
      <div class="mt-6 text-center">
        <a href="/servicios/" class="text-brand-700 font-semibold underline">Ver todos los servicios →</a>
      </div>
    </div>
  </section>

  <!-- Zonas Anillo 1 (internal linking home → zonas) -->
  <section class="max-w-5xl mx-auto px-4 py-12">
    <div class="text-center mb-8">
      <h2 class="text-2xl sm:text-3xl font-bold text-brand-900">Dónde damos servicio</h2>
      <p class="mt-2 text-slate-600">Granollers y su entorno más cercano, 24 horas.</p>
    </div>
    <div class="grid gap-3 sm:grid-cols-3 md:grid-cols-6">
      <a href="/" class="rounded-lg bg-brand-900 text-white px-4 py-3 font-medium text-center">Granollers</a>
      {zonas.map((z) => (
        <a href={`/zonas/${z.slug}/`} class="rounded-lg border border-slate-200 px-4 py-3 hover:border-brand-500 hover:text-brand-700 font-medium text-slate-700 text-center text-sm">
          {z.nombre}
        </a>
      ))}
    </div>
    <div class="mt-6 text-center">
      <a href="/zonas/" class="text-brand-700 font-semibold underline">Ver todas las zonas →</a>
    </div>
  </section>

  <!-- Destacado B2B: lanzamientos judiciales -->
  <section class="max-w-5xl mx-auto px-4 pb-12">
    <div class="rounded-2xl bg-brand-900 text-white p-8 sm:flex items-center justify-between gap-6">
      <div>
        <p class="text-accent-500 font-semibold uppercase tracking-wide text-sm">Servicio profesional · B2B</p>
        <h2 class="mt-2 text-2xl font-bold">Cerrajería para lanzamientos judiciales</h2>
        <p class="mt-2 text-slate-200 max-w-xl">Apoyo a procuradores y administradores de fincas en el Vallès Oriental y Barcelona. Precio cerrado por escrito.</p>
      </div>
      <a href="/lanzamientos-judiciales/" class="inline-block mt-4 sm:mt-0 shrink-0 rounded-lg bg-accent-500 text-brand-900 font-bold px-6 py-3 hover:brightness-95">
        Ver servicio →
      </a>
    </div>
  </section>

  <Resenas />
  <MapaNAP />
</Base>
