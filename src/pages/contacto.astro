---
import Base from '../layouts/Base.astro';
import SchemaNegocio from '../components/SchemaNegocio.astro';
import MapaNAP from '../components/MapaNAP.astro';
import negocio from '../data/negocio.json';

const breadcrumb = [
  { name: 'Inicio', path: '/' },
  { name: 'Contacto', path: '/contacto/' },
];
const waNumber = negocio.whatsapp_e164.replace('+', '');
const title = `Contacto · Cerrajero 24h en ${negocio.nap.localidad} | ${negocio.marca}`;
const description = `Contacta con tu cerrajero 24 horas en ${negocio.nap.localidad}. Te damos el precio cerrado por teléfono antes de salir.`;
---
<Base title={title} description={description} canonicalPath="/contacto/">
  <SchemaNegocio slot="head" breadcrumb={breadcrumb} />

  <section class="bg-brand-900 text-white">
    <div class="max-w-5xl mx-auto px-4 py-12 text-center">
      <h1 class="text-3xl sm:text-4xl font-bold">Contacto</h1>
      <p class="mt-4 text-lg text-slate-200 max-w-2xl mx-auto">Llámanos o escríbenos por WhatsApp. Te confirmamos el precio cerrado antes de desplazarnos.</p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 py-12 grid gap-5 sm:grid-cols-3 text-center">
    <a href={`tel:${negocio.telefono_e164}`} class="rounded-xl border border-slate-200 p-6 hover:border-brand-500">
      <p class="text-3xl">📞</p>
      <h2 class="mt-2 font-bold text-brand-900">Teléfono 24h</h2>
      <p class="mt-1 text-brand-700 font-semibold">{negocio.telefono_display}</p>
    </a>
    {negocio.whatsapp_e164 && (
      <a href={`https://wa.me/${waNumber}`} class="rounded-xl border border-slate-200 p-6 hover:border-brand-500">
        <p class="text-3xl">💬</p>
        <h2 class="mt-2 font-bold text-brand-900">WhatsApp</h2>
        <p class="mt-1 text-slate-600 text-sm">Envíanos una foto de tu cerradura</p>
      </a>
    )}
    <a href={`mailto:${negocio.email}`} class="rounded-xl border border-slate-200 p-6 hover:border-brand-500">
      <p class="text-3xl">✉️</p>
      <h2 class="mt-2 font-bold text-brand-900">Email</h2>
      <p class="mt-1 text-brand-700 font-semibold text-sm break-all">{negocio.email}</p>
    </a>
    <div class="rounded-xl border border-slate-200 p-6">
      <p class="text-3xl">🕐</p>
      <h2 class="mt-2 font-bold text-brand-900">Horario</h2>
      <p class="mt-1 text-slate-600 text-sm">{negocio.nap.horario_texto}</p>
    </div>
  </section>

  <MapaNAP />
</Base>
