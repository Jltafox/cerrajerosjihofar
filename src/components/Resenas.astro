---
// Bloque RESEÑAS · H5 (100% de los ganadores tienen bloque de reseñas on-page).
// El bloque está listo; las reseñas se trabajan aparte. Mientras resenas_provisionales
// sea true se muestran EJEMPLOS marcados y NO se emite AggregateRating en el schema.
import negocio from '../data/negocio.json';
const stars = (n: number) => '★★★★★'.slice(0, n) + '☆☆☆☆☆'.slice(0, 5 - n);
---
<section id="resenas" class="bg-slate-50 border-y border-slate-200">
  <div class="max-w-5xl mx-auto px-4 py-12">
    <div class="text-center mb-8">
      <h2 class="text-2xl sm:text-3xl font-bold text-brand-900">Lo que dicen nuestros clientes</h2>
      {!negocio.resenas_provisionales && negocio.resenas_total > 0 && (
        <p class="mt-2 text-slate-600">
          <span class="text-accent-500 font-bold">{negocio.resenas_rating_medio.toFixed(1)} ★</span>
          · {negocio.resenas_total} reseñas
        </p>
      )}
    </div>

    {negocio.resenas_provisionales && (
      <p class="mb-6 rounded-md bg-amber-50 border border-amber-300 text-amber-900 text-sm px-4 py-3">
        <strong>Reseñas de ejemplo.</strong> {negocio.resenas_nota}
      </p>
    )}

    <div class="grid gap-5 sm:grid-cols-3">
      {negocio.resenas.map((r) => (
        <figure class="rounded-xl bg-white border border-slate-200 p-5 flex flex-col">
          <div class="text-accent-500 text-lg" aria-label={`${r.rating} de 5`}>{stars(r.rating)}</div>
          <blockquote class="mt-3 text-sm text-slate-700 grow">“{r.texto}”</blockquote>
          <figcaption class="mt-4 text-xs font-semibold text-slate-500">{r.autor}</figcaption>
        </figure>
      ))}
    </div>

    <p class="mt-6 text-center text-xs text-slate-400">
      Cuando haya reseñas reales, el bloque emitirá automáticamente <code>AggregateRating</code> en el schema.
    </p>
  </div>
</section>
