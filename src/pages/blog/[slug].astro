---
import Base from '../../layouts/Base.astro';
import SchemaNegocio from '../../components/SchemaNegocio.astro';
import blog from '../../data/blog.json';
import servicios from '../../data/servicios.json';
import negocio from '../../data/negocio.json';

export function getStaticPaths() {
  return blog.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const servicioRel = servicios.find((s) => s.slug === post.servicio_rel);
const otros = blog.filter((p) => p.slug !== post.slug);

const breadcrumb = [
  { name: 'Inicio', path: '/' },
  { name: 'Blog', path: '/blog/' },
  { name: post.titulo, path: `/blog/${post.slug}/` },
];
const title = `${post.titulo} | ${negocio.marca}`;
---
<Base title={title} description={post.resumen} canonicalPath={`/blog/${post.slug}/`}>
  <SchemaNegocio
    slot="head"
    breadcrumb={breadcrumb}
    article={{ headline: post.titulo, description: post.resumen, datePublished: post.fecha, path: `/blog/${post.slug}/` }}
  />

  <nav aria-label="Migas de pan" class="max-w-3xl mx-auto px-4 pt-5 text-xs text-slate-500">
    <a href="/" class="hover:text-brand-500">Inicio</a> ›
    <a href="/blog/" class="hover:text-brand-500">Blog</a> ›
    <span class="text-slate-700">{post.titulo}</span>
  </nav>

  <article class="max-w-3xl mx-auto px-4 py-8">
    <h1 class="text-3xl sm:text-4xl font-bold text-brand-900">{post.titulo}</h1>
    <p class="mt-2 text-sm text-slate-400">Publicado el {post.fecha}</p>
    <p class="mt-4 text-lg text-slate-600">{post.resumen}</p>

    <div class="mt-8 space-y-8">
      {post.cuerpo.map((sec) => (
        <section>
          <h2 class="text-xl font-bold text-brand-900">{sec.h2}</h2>
          <p class="mt-2 text-slate-700 leading-relaxed">{sec.p}</p>
        </section>
      ))}
    </div>

    {servicioRel && (
      <div class="mt-10 rounded-xl bg-slate-50 border border-slate-200 p-5">
        <p class="font-semibold text-brand-900">¿Necesitas {servicioRel.nav.toLowerCase()} en {negocio.nap.localidad}?</p>
        <p class="mt-1 text-sm text-slate-600">Precio cerrado por teléfono antes de salir.</p>
        <div class="mt-3 flex flex-wrap gap-3">
          <a href={`/servicios/${servicioRel.slug}/`} class="rounded-lg border border-brand-500 text-brand-700 font-semibold px-4 py-2 hover:bg-brand-50">Ver {servicioRel.nav}</a>
          <a href={`tel:${negocio.telefono_e164}`} class="rounded-lg bg-brand-700 text-white font-semibold px-4 py-2 hover:bg-brand-900">📞 {negocio.telefono_display}</a>
        </div>
      </div>
    )}
  </article>

  <section class="bg-slate-50 border-t border-slate-200">
    <div class="max-w-3xl mx-auto px-4 py-10">
      <h2 class="text-xl font-bold text-brand-900 mb-4">Más artículos</h2>
      <ul class="space-y-2">
        {otros.map((p) => (
          <li><a href={`/blog/${p.slug}/`} class="text-brand-700 hover:underline font-medium">{p.titulo}</a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>
