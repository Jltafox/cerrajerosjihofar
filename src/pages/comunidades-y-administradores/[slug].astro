---
import Base from '../../layouts/Base.astro';
import SchemaNegocio from '../../components/SchemaNegocio.astro';
import comunidades from '../../data/comunidades.json';
import negocio from '../../data/negocio.json';

export function getStaticPaths() {
  return comunidades.map((s) => ({ params: { slug: s.slug }, props: { servicio: s } }));
}

const { servicio } = Astro.props;
const otros = comunidades.filter((s) => s.slug !== servicio.slug);

const breadcrumb = [
  { name: 'Inicio', path: '/' },
  { name: 'Comunidades y administradores', path: '/comunidades-y-administradores/' },
  { name: servicio.nav, path: `/comunidades-y-administradores/${servicio.slug}/` },
];
const title = `${servicio.h1} | ${negocio.marca}`;
---
<Base title={title} description={servicio.meta} canonicalPath={`/comunidades-y-administradores/${servicio.slug}/`}>
  <SchemaNegocio slot="head" serviceType={servicio.serviceType} faq={servicio.faq} breadcrumb={breadcrumb} />

  <nav aria-label="Migas de pan" class="max-w-5xl mx-auto px-4 pt-5 text-xs text-slate-500">
    <a href="/" class="hover:text-brand-500">Inicio</a> ›
    <a href="/comunidades-y-administradores/" class="hover:text-brand-500">Comunidades</a> ›
    <span class="text-slate-700">{servicio.nav}</span>
  </nav>

  <section class="bg-brand-900 text-white mt-4">
    <div class="max-w-5xl mx-auto px-4 py-12 text-center">
      <p class="text-accent-500 font-semibold uppercase tracking-wide text-sm">Servicio profesional · B2B</p>
      <h1 class="mt-3 text-3xl sm:text-4xl font-bold">{servicio.h1}</h1>
      <p class="mt-4 text-lg text-slate-200 max-w-2xl mx-auto">{servicio.intro}</p>
      <a href={`tel:${negocio.telefono_e164}`} class="inline-block mt-6 rounded-lg bg-accent-500 text-brand-900 font-bold px-6 py-3 hover:brightness-95">
        📞 Pedir presupuesto · {negocio.telefono_display}
      </a>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 py-12">
    <h2 class="text-2xl font-bold text-brand-900 mb-6">Qué incluye</h2>
    <ul class="grid gap-3 sm:grid-cols-2">
      {servicio.incluye.map((item) => (
        <li class="flex items-start gap-3 rounded-lg border border-slate-200 px-4 py-3">
          <span class="text-brand-500 font-bold">✓</span>
          <span class="text-slate-700">{item}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="max-w-3xl mx-auto px-4 pb-12">
    <h2 class="text-2xl font-bold text-brand-900 mb-6">Preguntas frecuentes</h2>
    <div class="space-y-3">
      {servicio.faq.map((f) => (
        <details class="rounded-lg border border-slate-200 px-4 py-3">
          <summary class="font-semibold text-slate-800 cursor-pointer">{f.q}</summary>
          <p class="mt-2 text-sm text-slate-600">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="bg-slate-50 border-t border-slate-200">
    <div class="max-w-5xl mx-auto px-4 py-12">
      <h2 class="text-xl font-bold text-brand-900 mb-6">Más para comunidades</h2>
      <div class="grid gap-3 sm:grid-cols-2">
        {otros.map((s) => (
          <a href={`/comunidades-y-administradores/${s.slug}/`} class="rounded-lg bg-white border border-slate-200 px-4 py-3 hover:border-brand-500 hover:text-brand-700 font-medium text-slate-700">
            {s.nav}
          </a>
        ))}
        <a href="/lanzamientos-judiciales/" class="rounded-lg bg-white border border-slate-200 px-4 py-3 hover:border-brand-500 hover:text-brand-700 font-medium text-slate-700">
          Lanzamientos judiciales
        </a>
      </div>
    </div>
  </section>
</Base>
